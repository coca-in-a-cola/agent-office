        {
          "id": "p_work_approval_wait",
          "name": "Approval Wait",
          "direction": "output",
          "kind": "status",
          "status_kind": "approval_wait"
        },
        {
          "id": "p_work_quota_exhausted",
          "name": "Quota Exhausted",
          "direction": "output",
          "kind": "control",
          "control_outcome": "quota_exhausted"
        },
        {
          "id": "p_work_commit_out",
          "name": "Commit Ref",
          "direction": "output",
          "kind": "data",
          "data_type": "CommitRef",
          "required": false,
          "cardinality": "single"
        },
        {
          "id": "p_work_partial_out",
          "name": "Partial Result",
          "direction": "output",
          "kind": "data",
          "data_type": "PartialResult",
          "required": false,
          "cardinality": "single"
        }
      ]
    },
