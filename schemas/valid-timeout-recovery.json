      "budgets": {
        "max_attempts": 2,
        "max_subagents": 1,
        "max_cost_micros": 1000000
      },
      "config": {
        "independent_of": ["node_work"],
        "binds_source": true
      },
      "ports": [
        {
          "id": "p_acc_ctrl_in",
          "name": "Acceptance Trigger",
          "direction": "input",
          "kind": "control",
          "control_outcome": "exec_in"
