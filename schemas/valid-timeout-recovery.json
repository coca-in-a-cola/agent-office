        {
          "id": "p_insp_commit_out",
          "name": "Recovered Commit",
          "direction": "output",
          "kind": "data",
          "data_type": "CommitRef",
          "required": false,
          "cardinality": "single"
        },
        {
          "id": "p_insp_evidence_out",
          "name": "Inspection Evidence",
          "direction": "output",
          "kind": "data",
          "data_type": "EvidenceRef",
          "required": true,
          "cardinality": "single"
        }
      ]
    },
    {
