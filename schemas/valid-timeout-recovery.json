        {
          "id": "p_acc_commit_in",
          "name": "Commit Under Review",
          "direction": "input",
          "kind": "data",
          "data_type": "CommitRef",
          "required": true,
          "cardinality": "single"
        },
        {
          "id": "p_acc_succ",
          "name": "Accepted",
          "direction": "output",
          "kind": "control",
          "control_outcome": "success"
        },
        {
          "id": "p_acc_defect",
          "name": "Rejected",
          "direction": "output",
          "kind": "control",
          "control_outcome": "defect"
        },
        {
          "id": "p_acc_evidence_out",
          "name": "Review Evidence",
          "direction": "output",
          "kind": "data",
          "data_type": "EvidenceRef",
          "required": true,
          "cardinality": "single"
        }
      ]
    },
    {
      "id": "node_end_success",
      "type": "End",
      "name": "Workflow Completed",
      "goal": "Record successful completion and release run resources",
      "config": {
        "terminal_outcome": "completed"
