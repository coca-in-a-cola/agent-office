        "routes": [
          {
            "route_id": "route_google_fast",
            "provider": "google",
            "model": "antigravity/gemini-3.8-flash-high",
            "executor": "omo",
            "enabled": true,
            "cooldown_seconds": 180
          },
          {
            "route_id": "route_anthropic_fast",
            "provider": "anthropic",
            "model": "claude-opus-5-5",
            "executor": "claude",
            "enabled": true,
            "cooldown_seconds": 180
          }
        ]
      }
    ],
    "approval_policies": [
      {
        "scope": "deploy:live",
        "required_role": "owner",
        "timeout_seconds": 3600,
        "auto_action_on_expiry": "deny"
      }
    ]
  },
  "limits": {
    "max_total_attempts": 10,
    "max_total_iterations": 5,
    "max_workflow_duration_seconds": 7200
  },
  "nodes": [
    {
      "id": "node_start",
      "type": "Start",
      "name": "Admission Gate",
      "goal": "Validate incoming change request and allocate run workspace",
      "ports": [
        {
          "id": "p_start_ctrl_out",
          "name": "Started",
          "direction": "output",
          "kind": "control",
          "control_outcome": "success"
        },
        {
          "id": "p_start_cr_out",
          "name": "Change Request",
          "direction": "output",
          "kind": "data",
          "data_type": "ChangeRequest",
          "required": true,
          "cardinality": "single"
        }
      ]
    },
    {
      "id": "node_work",
      "type": "Work",
      "name": "Software Implementation",
      "role": "webdev",
      "route_policy_id": "policy_rr_coding",
      "goal": "Implement requested feature and commit to git with verified test exit",
      "deadlines": {
        "queue_timeout_seconds": 300,
        "execution_timeout_seconds": 1800
      },
      "budgets": {
        "max_attempts": 3,
        "max_subagents": 2,
        "max_cost_micros": 5000000
      },
      "config": {
        "side_effecting": false,
        "requires_approval": false,
        "workspace_isolated": true
      },
      "ports": [
        {
          "id": "p_work_ctrl_in",
          "name": "Execute",
          "direction": "input",
          "kind": "control",
          "control_outcome": "exec_in"
        },
        {
          "id": "p_work_cr_in",
          "name": "Change Request",
          "direction": "input",
          "kind": "data",
          "data_type": "ChangeRequest",
          "required": true,
          "cardinality": "single"
        },
        {
          "id": "p_work_succ",
          "name": "Success",
          "direction": "output",
          "kind": "control",
          "control_outcome": "success"
        },
        {
          "id": "p_work_defect",
          "name": "Defect",
          "direction": "output",
          "kind": "control",
          "control_outcome": "defect"
        },
        {
          "id": "p_work_timeout",
          "name": "Timeout",
          "direction": "output",
          "kind": "control",
          "control_outcome": "timeout"
        },
        {
          "id": "p_work_failure",
          "name": "Failure",
          "direction": "output",
          "kind": "control",
          "control_outcome": "failure"
        },
        {
          "id": "p_work_quota_wait",
          "name": "Quota Wait",
          "direction": "output",
          "kind": "status",
          "status_kind": "quota_wait"
