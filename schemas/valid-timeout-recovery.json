      ]
    },
    {
      "id": "node_end_failed",
      "type": "End",
      "name": "Workflow Terminated",
      "goal": "Record stopped or failed status without silent continuation",
      "config": {
        "terminal_outcome": "failed"
      },
      "ports": [
        {
          "id": "p_end_fail_in",
          "name": "Terminal In",
          "direction": "input",
          "kind": "control",
          "control_outcome": "exec_in"
        }
      ]
    }
