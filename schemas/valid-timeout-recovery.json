      "name": "Inspect Partial Snapshot",
      "role": "qa",
      "route_policy_id": "policy_priority_fast",
      "goal": "Verify whether timed-out execution yielded a clean quiescent commit or recoverable state",
      "deadlines": {
        "queue_timeout_seconds": 120,
        "execution_timeout_seconds": 600
      },
      "budgets": {
        "max_attempts": 1,
        "max_subagents": 0,
        "max_cost_micros": 500000
      },
      "config": {
        "criteria": ["quiescent snapshot", "head sha present", "clean test subset"]
      },
      "ports": [
        {
          "id": "p_insp_ctrl_in",
          "name": "Inspect Trigger",
          "direction": "input",
          "kind": "control",
          "control_outcome": "exec_in"
